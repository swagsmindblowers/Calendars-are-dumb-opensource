DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret
AUTH_SECRET=""

# Needed on Cloudflare Workers; the platform isn't auto-detected as a
# trusted host the way Vercel is.
AUTH_TRUST_HOST="true"

# Local-only: set to "true" to add a "Continue as dev user" option on the
# sign-in page that skips OAuth entirely (useful for trying the ICS import
# without registering a Google/Microsoft app first). Leave unset/"false"
# anywhere this app is reachable by anyone else — it bypasses real auth.
AUTH_DEV_BYPASS="false"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Enable the "Google Calendar API" and add scope calendar.readonly.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID / Azure AD app registration (entra.microsoft.com).
# Personal accounts and any work/school account can consent for themselves
# under the "common" tenant, without org admin approval.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Resend (resend.com) — sends booking confirmation emails. Free tier is
# plenty. Without this set, confirmation emails are just skipped (logged).
RESEND_API_KEY=""
# Must be a domain you've verified with Resend, or leave as their shared
# sandbox address for testing.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Public URL of your deployment, e.g. "https://cal.example.com". Used for
# OAuth redirects, cancel links in emails, and the host shown on public pages.
# In production this is set via wrangler.jsonc's "vars" instead.
APP_URL=""

# Optional: shown in the footer and on the privacy/terms pages.
CONTACT_EMAIL=""

# Base64-encoded 32-byte AES key, used to encrypt Account.access_token/
# refresh_token at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every stored token undecryptable -- there's no
# re-encryption path, so treat it like any other long-lived secret.
TOKEN_ENCRYPTION_KEY=""
